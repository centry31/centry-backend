generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())

  tgId   BigInt  @unique // Telegram user id
  chatId BigInt? // для личных уведомлений от бота

  username    String? @unique // @username (может быть null)
  displayName String

  // timeZone String @default("Europe/Moscow")

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  MagicLink     MagicLink[]
  SpaceMember   SpaceMember[]
  Event         Event[]
  Space         Space[]         @relation("SpaceOwner")
  SpaceLinkCode SpaceLinkCode[]
  SpaceInvite   SpaceInvite[]

  @@map("users")
}

model Space {
  id          String        @id @default(uuid())
  name        String
  description String?
  owner       User          @relation("SpaceOwner", fields: [ownerID], references: [id])
  ownerID     String
  SpaceMember SpaceMember[]

  event         Event[]
  SpaceTgChat   SpaceTgChat[]
  SpaceLinkCode SpaceLinkCode[]
  SpaceInvite   SpaceInvite[]

  @@map("spaces")
}

// промежуточная таблица для many to many
model SpaceMember {
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId String

  @@id([userId, spaceId])
  @@map("space_members")
}

enum TgChatType {
  private
  group
  supergroup
  channel
}

model SpaceTgChat {
  id String @id @default(uuid())

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  chatTgId  BigInt
  chatType  TgChatType
  chatTitle String?

  // 0 = весь чат (без темы). Никогда не null → безопасный upsert
  messageThreadId Int @default(0)

  initiatedByTgId BigInt
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spaceId, chatTgId, messageThreadId])
  @@index([chatTgId])
  @@map("space_tg_chats")
}

model SpaceLinkCode {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  hashCode String @unique

  createdByUserId String
  createdBy       User   @relation(fields: [createdByUserId], references: [id])

  expiresAt DateTime
  usedAt    DateTime?
  maxUses   Int       @default(1)
  usedCount Int       @default(0)

  createdAt DateTime @default(now())

  @@index([spaceId])
  @@index([expiresAt])
  @@index([createdByUserId])
  @@map("space_link_codes")
}

model MagicLink {
  id        String    @id @default(uuid())
  hashCode  String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("magic_links")
}

model SpaceInvite {
  id              String @id @default(uuid())
  createdByUserId String
  createdBy       User   @relation(fields: [createdByUserId], references: [id])
  hashCode        String

  maxUses   Int @default(1)
  usedCount Int @default(0)

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([spaceId])
  @@index([expiresAt])
  @@index([createdByUserId])
  @@map("space_invites")
}

model EventReminder {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // относительное напоминание
  offsetMinutes Int // >= 0, "за сколько минут до start"

  // кому и куда шлём
  // userId String? // null = всем участникам; иначе персонально

  scheduledAt DateTime? // можно преформировать абсолютное время
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([scheduledAt])
  @@map("event_reminders")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  start       DateTime
  end         DateTime
  isAllDay    Boolean  @default(false)

  location String?

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders EventReminder[]

  @@map("events")
}
