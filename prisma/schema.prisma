generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())

  tgId   BigInt  @unique // Telegram user id
  chatId BigInt? // для личных уведомлений от бота

  username    String? @unique // @username (может быть null)
  displayName String

  // timeZone String @default("Europe/Moscow")

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  MagicLink   MagicLink[]
  SpaceMember SpaceMember[]
  Event       Event[]
  Space       Space[]       @relation("SpaceOwner")

  @@map("users")
}

model Space {
  id          String        @id @default(uuid())
  name        String
  description String?
  owner       User          @relation("SpaceOwner", fields: [ownerID], references: [id])
  ownerID     String
  SpaceMember SpaceMember[]

  event Event[]

  @@map("spaces")
}

// промежуточная таблица для many to many
model SpaceMember {
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId String

  @@id([userId, spaceId])
  @@map("space_members")
}

model MagicLink {
  id        String    @id @default(uuid())
  hashCode  String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("magic_links")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  start       DateTime
  end         DateTime
  isAllDay    Boolean  @default(false)

  location String?

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}
